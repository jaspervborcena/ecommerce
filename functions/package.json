{
  "name": "tovrika-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "backfill:sample-data": "node scripts/sample-data-backfill.js",
    "backfill:customer-journey": "node scripts/sample-data-backfill.js --fixture firestore-customer-journey.json",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "lint": "echo 'no lint configured'",
    "test:backfill": "node --test scripts/sample-data-backfill.spec.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.5.0",
    "firebase-functions": "^4.7.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
